{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lut-studio",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-01",
  // Custom domain: requires openanthropic.com on this Cloudflare account.
  // `custom_domain` lets wrangler create the DNS record + certificate.
  // Remove this block to deploy to *.workers.dev instead.
  "routes": [{ "pattern": "lut.openanthropic.com", "custom_domain": true }],
  // Also publish on the default *.workers.dev hostname. That host is not a zone,
  // so the zone-level bot policy (which currently 403s GPTBot/ClaudeBot and asks
  // Baiduspider to go away via managed robots.txt) does not apply there. The
  // pages carry the canonical URL of lut.openanthropic.com, so search engines
  // still consolidate on the real domain; this only gives crawlers a route to
  // content the zone refuses. Remove it once the dashboard policy is fixed.
  "workers_dev": true,
  // First-party analytics (pageviews, funnel events, field Core Web Vitals and
  // crawler hits). Schema: scripts/analytics-schema.sql. This is the only state
  // the site has; photos still never leave the browser.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lut-studio-db",
      "database_id": "fa2d28cf-7395-4d6d-997a-7b733a830e54"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker owns URLs (clean URLs, 301s, 404). Without run_worker_first the
    // assets layer answers first with its own 307s; with the default
    // auto-trailing-slash it also rewrites `.html` before the Worker can map it.
    "run_worker_first": true,
    "html_handling": "none"
  }
}
